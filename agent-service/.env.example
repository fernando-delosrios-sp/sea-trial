# OpenAI-compatible LLM (required before processing requests)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# HTTP port (Render sets this automatically in production)
PORT=3000

# Grafana Cloud OTLP logging (optional — disabled by default locally)
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-6.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=sea-trial-agent-service
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
