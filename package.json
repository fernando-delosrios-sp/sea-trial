{
  "name": "sea-trial",
  "private": true,
  "workspaces": [
    "agent-service",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @sea-trial/shared && npm run build -w @sea-trial/observability && npm run build -w @sea-trial/agent-service",
    "test": "npm run test --workspaces --if-present && bash scripts/validate-deploy-workflow.sh",
    "dev:agent": "npm run dev -w @sea-trial/agent-service"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}



