# Agent service URL (Render or local)
# Deployed values are set by GitHub Actions via `slack env set` during CI deploy.
AGENT_SERVICE_URL=http://localhost:3000

# Grafana Cloud OTLP logging (optional — disabled by default locally)
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-6.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tes-slack-app

# Slack app credentials (set via `slack env add` for deployed apps)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Workspace ID (T…) — required for pinned index navigation links
SLACK_TEAM_ID=
