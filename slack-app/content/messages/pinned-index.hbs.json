[
  {
    "type": "section",
    "text": {
      "type": "mrkdwn",
      "text": {{{json messageText}}}
    }
  }{{#unless onboardingComplete}},
  {
    "type": "actions",
    "block_id": "pinned_index_actions",
    "elements": [
      {
        "type": "button",
        "text": { "type": "plain_text", "text": "Complete onboarding" },
        "style": "primary",
        "action_id": "complete_onboarding",
        "value": {{{json buttonValueJson}}}
      }
    ]
  }{{else}},
  {
    "type": "actions",
    "block_id": "pinned_index_publish_actions",
    "elements": [
      {
        "type": "button",
        "text": { "type": "plain_text", "text": "Publish situation report" },
        "action_id": "publish_situation_report",
        "value": {{{json publishButtonValueJson}}}
      }
    ]
  }{{/unless}}
]
