{
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@slack/deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.3.0/",
    "@slack/deno-slack-api/": "https://deno.land/x/deno_slack_api@2.6.0/",
    "@tes/shared/": "../packages/shared/src/",
    "@tes/observability/": "../packages/observability/dist/",
    "std/": "https://deno.land/std@0.224.0/",
    "handlebars": "npm:handlebars@4.7.8"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "fmt": {
    "exclude": ["../node_modules"]
  },
  "lint": {
    "exclude": ["../node_modules"]
  }
}




