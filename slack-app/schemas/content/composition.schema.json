{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["canvas", "list", "workflow"] },
        "ref": { "type": "string", "minLength": 1 },
        "link": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "tab": { "const": true },
        "bookmark": { "const": true },
        "featured": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "canvas" } } },
          "then": {
            "required": ["ref"],
            "not": {
              "anyOf": [
                { "required": ["link"] },
                { "required": ["bookmark"] },
                { "required": ["featured"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "list" } } },
          "then": {
            "required": ["ref"],
            "not": {
              "anyOf": [
                { "required": ["link"] },
                { "required": ["tab"] },
                { "required": ["featured"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "workflow" } } },
          "then": {
            "required": ["link"],
            "not": {
              "anyOf": [
                { "required": ["ref"] },
                { "required": ["tab"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
