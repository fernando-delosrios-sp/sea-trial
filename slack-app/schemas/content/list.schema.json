{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "List content — column types from schemas/content/capabilities/list.v1.json",
  "type": "object",
  "required": ["name", "columns", "seed", "behavior"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "type"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "text",
              "rich_text",
              "select",
              "multi_select",
              "user",
              "assignee",
              "date",
              "due_date",
              "link",
              "checkbox",
              "number",
              "email",
              "phone",
              "channel",
              "attachment",
              "message",
              "canvas",
              "rating",
              "vote",
              "completed"
            ]
          },
          "is_primary_column": { "type": "boolean" },
          "options_ref": { "type": "string" },
          "options": {
            "type": "object",
            "properties": {
              "format": { "type": "string" },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "properties": {
                    "value": { "type": "string" },
                    "label": { "type": "string" },
                    "color": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "seed": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array" }
      }
    },
    "behavior": {
      "type": "object",
      "required": ["field_change"],
      "properties": {
        "field_change": { "type": "array" }
      }
    }
  },
  "additionalProperties": false
}
