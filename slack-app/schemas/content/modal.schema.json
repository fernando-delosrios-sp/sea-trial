{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["callback_id", "title", "submit", "blocks", "contract"],
  "properties": {
    "callback_id": { "type": "string", "minLength": 1 },
    "title": { "type": "object" },
    "submit": { "type": "object" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "contract": {
      "type": "object",
      "required": ["block_ids"],
      "properties": {
        "block_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "dynamic": { "type": "object" }
  },
  "additionalProperties": false
}
